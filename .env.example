# .env.example — JANGAN commit file .env asli
# Semua key di bawah hanya dipakai SERVER (runtimeConfig privat), tidak pernah dibundle ke klien.

# --- AI (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3n-e4b-it:free

# --- Solana (wallet devnet saja!) ---
SOLANA_PRIVATE_KEY=            # base58, wallet dev khusus devnet
SOLANA_CLUSTER=devnet
PAPER_MINT=9xnPMY8wRSGBQf212SSasSJwkTqb9Fi3GrWb32Lf9W4d

# --- Token ekonomi ---
FAUCET_AMOUNT=1000
FAUCET_COOLDOWN_HOURS=24
REWARD_AMOUNT=100

# --- Database (leaderboard & cooldown faucet) ---
# Jika diisi (Upstash Redis / Vercel KV) data bertahan setelah redeploy.
# Jika kosong, fallback ke file JSON lokal (.data/db.json) — cukup untuk dev.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Variasi prefix NUXT_ (mis. NUXT_OPENROUTER_API_KEY) juga didukung Nuxt runtimeConfig.
